# ============================== 构建产物 ==============================
target/
*.jar
*.war
*.class
!**/mvnw
!**/.mvn/wrapper/maven-wrapper.jar

# ============================== 运行时数据 ==============================
# fat jar 运行目录（49MB，构建时可重新生成）
oa-backend/run/
# 应用日志
oa-backend/logs/
*.log
# 上传的附件（运行时业务数据，不入库）
oa-backend/data/attachments/
# 演示库快照（含真实业务数据、用户记录与审计日志，绝不入库）
oa-backend/sql/demo_snapshot_*.sql
# 本地 JWT 签名密钥（启动脚本首次运行自动生成，绝不入库）
oa-backend/.jwt_secret
# 环境变量文件：含数据库/Redis/OSS 真实凭据与 JWT 密钥。
# 本仓库是 public，一旦入库等于把生产凭据与"伪造管理员令牌"的钥匙一起公开。
# 模板见 oa-backend/docker-test/.env.example（可入库，只有占位符）。
# 注意：只忽略 .env 本身，.env.example 必须保留在版本控制里。
.env
**/.env
!**/.env.example

# ============================== IDE / 编辑器 ==============================
.idea/
*.iml
.vscode/
.run/
*.swp
*.swo

# ============================== 操作系统 ==============================
.DS_Store
Thumbs.db

# ============================== 工具工作目录 ==============================
# WorkBuddy 会话数据/备份/记忆由工具自行管理，不纳入版本控制
.workbuddy/

# ============================== Python ==============================
__pycache__/
*.py[cod]

# ============================== Node ==============================
node_modules/
npm-debug.log*
yarn-error.log*
