const {createApp,ref,reactive,computed,onMounted,watch,nextTick}=Vue;

/* =========================================================================
   海峡金 OA —— 前端联调版（真实后端驱动）
   后端：Spring Boot 3 + Flowable 7，默认 http://127.0.0.1:8080
   本文件替换原型的 mock 逻辑层；模板与样式保持原样。
   ========================================================================= */
/* 后端地址：
   ① 优先 window.HXJ_API_BASE（换环境时在页面顶部覆盖即可）；
   ② 若页面本身由后端提供（同源 8080），直接用同源地址 —— 此时请求不受 CORS 约束，
      可绕开「CORS 类浏览器扩展改写响应头」导致的跨域拦截；
   ③ 否则（file:// 直开）回落到 http://127.0.0.1:8080。 */
const API_BASE = (window.HXJ_API_BASE
  || (location.protocol.indexOf('http') === 0 && location.port === '8080' ? location.origin : 'http://127.0.0.1:8080')
).replace(/\/$/, '');
const TOKEN_KEY = 'hxj_oa_token';

const STATUS_TEXT = {0:'草稿',1:'待审批',2:'审批中',3:'已通过',4:'已驳回',5:'已撤回',6:'已归档'};
const REJECT_TARGETS = [
  {label:'提交人',        value:'START'},
  {label:'直属部门负责人', value:'n2'},
  {label:'核算会计',      value:'n3'},
  {label:'内控合规',      value:'n3'},
  {label:'出纳',          value:'n5'}
];
const DEMO_ACCOUNTS = [
  {account:'admin',     name:'系统管理员', title:'全部权限'},
  {account:'huangxm',   name:'黄小明',    title:'普通员工 · 发起人'},
  {account:'linjl',     name:'林经理',    title:'部门负责人'},
  {account:'wangkj',    name:'王会计',    title:'核算会计'},
  {account:'zhangzong', name:'张总',      title:'公司领导 · 大额'},
  {account:'zhaocs',    name:'赵出纳',    title:'出纳'},
  {account:'chennk',    name:'陈内控',    title:'内控合规'},
  /* 以下两个审批人此前缺失，导致「用印申请」和「大额报销」两条链路在界面上无法走完 */
  {account:'zhouzh',    name:'周综合',    title:'部门负责人 · 综合管理部 · 用印办理'},
  {account:'lifinance', name:'李财务',    title:'财务总监 · 报销大额'}
];
const DEMO_PASSWORD = '123456';

/* ================= HTTP 封装 ================= */
function getToken(){ return localStorage.getItem(TOKEN_KEY) || ''; }
function setToken(t){ t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY); }

let onUnauthorized = null;

/* ---------- 故障判定：真离线 vs 被浏览器拦截跨域 ----------
   两者在 fetch 里都表现为 TypeError，但成因与解法完全不同：
   · 真离线      → 服务没起，启动后端会自动重连。
   · 跨域被拦    → 服务活着，但响应头被改写（典型是 CORS 类浏览器扩展 / 抓包代理），
                   此时改用同源地址打开页面即可彻底绕开，不需要动后端。 */
const OFFLINE_HINT = '连不上后端 ' + API_BASE + '（服务未启动或已停止）。启动后端后会自动重连，也可点下方「重试连接」。';
const CORS_HINT = '后端其实在运行，但这次请求被浏览器拦截了跨域（多见于 CORS 类浏览器扩展改写了响应头）。'
  + '请改用同源地址打开本页面，即可彻底绕开：' + API_BASE + '/oa.html';
/** no-cors 模式不受 CORS 约束：只要服务活着就能拿到 opaque 响应 → 说明是跨域被拦而非离线 */
async function probeReachable(){
  try {
    const ctl = new AbortController();
    const timer = setTimeout(function(){ ctl.abort(); }, 2500);
    await fetch(API_BASE + '/v3/api-docs', {mode:'no-cors', cache:'no-store', signal: ctl.signal});
    clearTimeout(timer);
    return true;
  } catch (e) { return false; }
}

async function http(path, opts){
  opts = opts || {};
  let url = API_BASE + path;
  if (opts.params){
    const q = new URLSearchParams();
    Object.entries(opts.params).forEach(function(kv){
      if (kv[1] !== '' && kv[1] !== null && kv[1] !== undefined) q.append(kv[0], kv[1]);
    });
    const qs = q.toString();
    if (qs) url += (url.indexOf('?') >= 0 ? '&' : '?') + qs;
  }
  const headers = {'Content-Type':'application/json'};
  const tk = getToken();
  if (tk) headers['Authorization'] = 'Bearer ' + tk;

  let res;
  try {
    res = await fetch(url, {
      method: opts.method || 'GET',
      headers: headers,
      body: opts.body === undefined ? undefined : JSON.stringify(opts.body)
    });
  } catch (e) {
    const reachable = await probeReachable();
    const err = new Error(reachable ? CORS_HINT : OFFLINE_HINT);
    err.network = true;
    err.cors = reachable;
    throw err;
  }
  if (res.status === 401){ if (onUnauthorized) onUnauthorized(); throw new Error('未登录或登录已过期'); }
  let json;
  try { json = await res.json(); }
  catch (e) { throw new Error('响应解析失败（HTTP ' + res.status + '）'); }
  if (json.code !== 0){
    const err = new Error(json.msg || ('请求失败 HTTP ' + res.status));
    err.code = json.code;
    err.data = json.data;
    throw err;
  }
  return json.data;
}

const api = {
  login:        function(a,p){ return http('/api/auth/login', {method:'POST', body:{account:a, password:p}}); },
  me:           function(){ return http('/api/auth/me'); },
  docTypes:     function(){ return http('/api/documents/types'); },
  docs:         function(params){ return http('/api/documents', {params:params}); },
  docDetail:    function(id){ return http('/api/documents/' + id); },
  createDoc:    function(body){ return http('/api/documents', {method:'POST', body:body}); },
  submitDoc:    function(id){ return http('/api/documents/' + id + '/submit', {method:'POST'}); },
  withdrawDoc:  function(id){ return http('/api/documents/' + id + '/withdraw', {method:'POST'}); },
  todos:        function(){ return http('/api/todos', {params:{limit:200}}); },
  doneTodos:    function(){ return http('/api/todos/done'); },
  approve:      function(body){ return http('/api/todos/approve', {method:'POST', body:body}); },
  countersign:  function(body){ return http('/api/todos/countersign', {method:'POST', body:body}); },
  flowConfigs:  function(){ return http('/api/flows/configs'); },
  flowDetail:   function(id){ return http('/api/flows/configs/' + id); },
  flowPreview:  function(id, body){ return http('/api/flows/configs/' + id + '/preview', {method:'POST', body:body||{}}); },
  deptTree:     function(){ return http('/api/depts/tree'); },
  users:        function(){ return http('/api/users'); },
  roles:        function(){ return http('/api/roles'); },
  dicts:        function(){ return http('/api/dicts'); },
  permissions:  function(){ return http('/api/auth/permissions'); }
};

