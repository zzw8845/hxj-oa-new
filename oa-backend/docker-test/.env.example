# ===========================================================================
#  海峡金 OA · 环境变量模板
#
#  用法（两步）：
#      cp .env.example .env
#      把下面所有 CHANGE_ME 换成真实值
#
#  【为什么必须外部化】本仓库是 public。任何写进 yml/代码的密钥都等于公开泄露 ——
#  这不是假想风险：上一版代码里内置了一个能通过长度校验的默认 JWT 密钥，
#  于是"忘配置"不报错、服务照常对外发令牌，而那串默认值随仓库一起公开，
#  等于把管理员令牌的伪造权一起公开了。所以现在的原则是：
#  密钥只存在于 .env，.env 永不入库，未配置就启动失败（fail-fast）而不是静默降级。
#
#  【本地开发共用】项目根目录的「启动联调版.command」也会读这个文件，
#  本地与服务器复用同一份配置，避免"本地跑得通、部署就报错"的漂移。
# ===========================================================================

# ---------------------------------------------------------------- 基础
TZ=Asia/Shanghai
# 日志目录（容器里由 docker-compose 挂载到宿主机 ./logs）
OA_LOG_DIR=/logs
# 打开接口文档（/swagger-ui.html）。排查用；生产环境必须是 false。
OA_OPENAPI_ENABLED=true
# 独立前端域名白名单（逗号分隔）。前后端同源时可留空。
OA_CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- MySQL
MYSQL_HOST=CHANGE_ME
MYSQL_PORT=3306
MYSQL_DATABASE=CHANGE_ME
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- Redis
# 用于登录失败限速与权限快照缓存。蓝绿双实例部署时必须走 Redis，
# 否则进程内计数会被"轮流打两个实例"绕过（10 次/5 分钟变成 20 次/5 分钟）。
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
# 不要用 0：该 Redis 实例常与其他项目共用，db0/db1/db2 可能已被占用。
# 选一个实测为空的索引，避免别人 FLUSHDB 时连带清掉我们的数据。
REDIS_DATABASE=3

# ---------------------------------------------------------------- 阿里云 OSS
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME
# 私有桶：业务附件，只经后端鉴权后代理下载，不直接对外暴露 URL
OSS_BUCKET=CHANGE_ME
# 公开桶：可匿名访问的资源（当前代码暂无此类资源，预留）
OSS_PUBLIC_BUCKET=CHANGE_ME
# 附件存储方式：oss=对象存储 / local=容器内磁盘（容器重建即丢，仅应急用）
OA_STORAGE_TYPE=oss

# ---------------------------------------------------------------- JWT 签名密钥
# 【必须自己生成，不要用示例值】生成方式：
#     head -c 48 /dev/urandom | base64 | tr -d '\n'
# 要求至少 32 字节，否则启动时会被 JwtUtils 拒绝。
# 该串一旦泄露，任何人都能伪造管理员令牌直接调用全部接口 ——
# 换密钥会让所有已登录用户立即失效，这是预期行为。
OA_JWT_SECRET=CHANGE_ME
