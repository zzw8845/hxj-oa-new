# ===========================================================================
#  海峡金 OA · nginx 站点配置
#
#  【安装位置】/opt/docker/nginx/conf/include/hxj-oa-test.wgit123.com.conf
#  （该目录在宿主机上，被 nginx 容器挂载到 /opt/include，由 nginx.conf 末尾的
#    `include /opt/include/*.conf;` 加载。放这里而不是放进容器：
#    容器重建不丢配置，也不用 exec 进容器里改文件。）
#
#  【装完必须做】
#      docker exec nginx nginx -t && docker exec nginx nginx -s reload
#    nginx -t 失败时**不要** reload —— 一个写坏的 include 文件会让 reload 失败，
#    更糟的是如果直接重启 nginx，整个 nginx 起不来，同服务器上
#    trace-web / trace-mng / trace-api / rlzx-wms 四个站点会一起挂掉。
#    （run.sh 里已经实现了"先 nginx -t 校验，失败立刻回滚配置"的闸门。）
#
#  ┌─────────────────────────────────────────────────────────────────────────┐
#  │ @@UPSTREAM_HOST@@ 该怎么填：                                            │
#  │   本机实测值 = 172.23.148.199（宿主 eth0 的 IP）。                       │
#  │   依据是同服务器上已验证可用的 rlzx-wms.conf 与 trace-*.conf，           │
#  │   它们都写成 `proxy_pass http://172.23.148.199:8091/` —— 即               │
#  │   「宿主 IP + 容器发布端口」，而不是容器名。                             │
#  │                                                                         │
#  │ 【为什么不用容器名（比如 http://oa:8080）】                              │
#  │   nginx 与 OA 确实同在 docker-compose_wg-network 上，用容器名技术上可行， │
#  │   而且能省掉端口发布。但 upstream 里的域名是**在 nginx 启动时解析**的：   │
#  │   若某次开机 nginx 先于 oa 容器启动，解析失败会让 **nginx 整个起不来**，  │
#  │   代价是上面四个别人的站点一起 502。用固定 IP 则是"即使 OA 没起来，      │
#  │   nginx 照常启动，只有 OA 这一个站点 502"，爆炸半径小得多。              │
#  │                                                                         │
#  │ 【已知脆弱点】eth0 是 DHCP 拿的地址（ip addr 显示 dynamic）。若哪天地址   │
#  │   变了，这里以及 wms/trace 的配置会一起失效。这是本机**既有**的脆弱点，   │
#  │   不是本次引入的；要根治得给宿主配静态内网 IP。                          │
#  └─────────────────────────────────────────────────────────────────────────┘
# ===========================================================================

upstream oa_backend {
    # 蓝绿切换时 run.sh 只改这一行的端口：8010（蓝）↔ 9010（绿）
    server @@UPSTREAM_HOST@@:8010;
    keepalive 32;
}

# ---------------------------------------------------------------------------
# 80：无条件跳转到 HTTPS。
# OA 的登录请求携带账号口令，之后所有请求携带 JWT —— 明文 HTTP 上这些
# 都是可以被中间人直接读走的。所以这里不做"80 与 443 同时服务"，
# 而是强制升级，避免有人图省事用 http:// 登录后长期沿用。
# ---------------------------------------------------------------------------

# 【Basic Auth 已于 2026-09-22 应用户要求移除】
# 曾短暂启用（挡公网弱口令扫描），演示口令轮换后不再需要；完整实现（map 兼容 Bearer、
# htpasswd 权限坑）沉淀在 git 历史 b316a84，需要时照抄。当时实测过的三个坑：
#   · htpasswd 必须 644（600 会让 nginx worker 读不了 → 全部请求 500）；
#   · 与 JWT 同头冲突：/api/** 且带 Bearer 要跳过 Basic，map 组合串
#     "$oa_api_path:$http_authorization" 的冒号必须出现在正则里（~^1:Bearer）；
#   · verify_deployed.sh/watchdog.sh 的 OA_SITE_BASIC 支持保留（未设置时自动不生效）。

server {
    listen       80;
    server_name  @@SERVER_NAME@@;

    # 用 301 而不是 302：浏览器会记住，后续请求直接走 HTTPS，不再来回跳一次
    return 301 https://$host$request_uri;
}

server {
    listen       443 ssl;
    server_name  @@SERVER_NAME@@;

    # 证书文件被**三个站点共用**（hxj-oa-test / trace-mng-test / trace-api-test），
    # 由服务器上的 certbot 自动续期并覆盖同名文件（见 docker-test/cert-deploy-hook.sh）。
    # 不要手工替换这里的内容 —— 手工改过之后，下一次自动续期会把它覆盖掉，
    # 而"我明明改过了"会让人怀疑是续期把配置弄坏了。
    #
    # 【历史】原先这张是外购的 Certum 通配符 *.wgit123.com，
    # 2026-10-13 到期且没有任何自动续期（80 是 301 强制跳转，到期症状是
    # "整站打不开"而不是"提示证书错误"，很容易误判成网络/后端问题）。
    # 现已换成 Let's Encrypt 三域名证书（90 天有效、到期前 30 天自动续），
    # 旧证书留在同目录 *.certum.bak 以备回退。
    ssl_certificate      /opt/https/wgit123.com.pem;
    ssl_certificate_key  /opt/https/wgit123.com.key;
    ssl_protocols        TLSv1.2 TLSv1.3;

    charset utf-8;

    # 【必须与后端对齐】后端 spring.servlet.multipart.max-request-size=60MB。
    # 这里若小于它，一个 60MB 的多附件提交会被 nginx 直接以 413 拒掉，
    # 而前端只看到"上传失败"，排查时很容易怀疑到后端头上。
    client_max_body_size 64m;

    access_log /var/log/nginx/oa.access.log;
    error_log  /var/log/nginx/oa.error.log warn;

    location / {
        proxy_pass         http://oa_backend;

        # HTTP/1.1 + 清空 Connection 才能复用 keepalive 连接池
        proxy_http_version 1.1;
        proxy_set_header   Connection "";

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # 台账导出会一次性生成整张表，超时太短会在数据量大时被 nginx 掐断连接。
        # 后端用的是 HTTP 响应流式写出，这里只要不主动断就行。
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        # 附件下载是流式的，关掉缓冲才能让浏览器尽快开始接收
        proxy_buffering off;
    }
}
